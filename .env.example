# =================================
# Kabunote 環境変数テンプレート
# =================================
#
# ■ 環境分離の仕組み（Next.js自動切替）
#   - .env.local           → 本番用Supabaseプロジェクトの接続情報
#   - .env.development.local → 開発用Supabaseプロジェクトの接続情報
#
#   `npm run dev` (NODE_ENV=development) では .env.development.local が優先されます。
#   `npm run build` (NODE_ENV=production) では .env.local が使われます。
#
# ■ セットアップ手順
#   1. Supabaseで開発用プロジェクトを作成（例: kabunote-dev）
#   2. SQL Editorで scripts/setup-dev-db.sql を実行（テーブル・RLS・トリガー作成）
#   3. このファイルを .env.development.local にコピーして開発用の値を設定
#      cp .env.example .env.development.local
#   4. 本番用は .env.local に本番Supabaseの値を設定
#      cp .env.example .env.local
#   5. Google OAuth設定（Supabase Dashboard > Authentication > Providers > Google）

# ---------------------------------
# データベース（必須）
# ---------------------------------
# PostgreSQL接続文字列（Prisma用）
# Transaction Pooler(6543): 通常クエリ用
# Session Pooler(5432): DDL用（prisma db push等）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE"

# ---------------------------------
# Supabase（必須）
# ---------------------------------
# SupabaseプロジェクトのURL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabaseアノニマスキー（クライアント側で使用）
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabaseサービスロールキー（サーバー側のみ）
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------
# Google Analytics（任意）
# ---------------------------------
# GA4の測定ID（未設定の場合はGA無効）
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ---------------------------------
# Sentry エラー監視（任意）
# ---------------------------------
# SentryのDSN（未設定の場合はSentry無効）
# NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
# Sentry組織名・プロジェクト名（ソースマップアップロード用、ビルド時のみ）
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"
# Sentry認証トークン（ソースマップアップロード用、ビルド時のみ）
# SENTRY_AUTH_TOKEN="sntrys_xxxxx"

# ---------------------------------
# Slack通知（任意）
# ---------------------------------
# フィードバック受信時のSlack通知用Webhook URL（未設定の場合は通知無効）
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXXX/XXXX/XXXX"

# ---------------------------------
# Basic認証（任意）
# ---------------------------------
# 設定するとランディングページ以外にBasic認証がかかる
# ステージング環境での保護用
# BASIC_AUTH_USERNAME="username"
# BASIC_AUTH_PASSWORD="password"
