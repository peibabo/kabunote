// Kabunote Database Schema
// 投資思考整理ダッシュボードのためのデータベーススキーマ

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ユーザー管理
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  picture       String?
  authProvider  String    @map("auth_provider") // "google", "email"
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // ユーザー設定
  cashAmount           Decimal?  @default(0) @map("cash_amount")
  nextActionMemo       String?   @map("next_action_memo")
  onboardingCompleted  Boolean   @default(false) @map("onboarding_completed")

  // リレーション
  stocks        Stock[]
  favoriteGroups FavoriteGroup[]
  snoozedAlerts SnoozedAlert[]
  feedbacks     Feedback[]

  @@map("app_users")
}

// 銘柄マスター情報
model Stock {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  symbol      String    // 銘柄コード (例: "7203")
  name        String?   // 会社名
  sector      String?   // 業種
  market      String?   // 市場
  order       Int       @default(0) // 表示順序
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // リレーション
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  memo           StockMemo?
  prices         StockPrice[]
  positions      StockPosition[]
  events         StockEvent[]
  dividend       StockDividend?
  benefit        StockBenefit?
  tags           StockTag[]
  nextAction     NextActionPlan?
  tabStates      StockTabState[]
  favoriteGroups StockFavoriteGroup[]

  @@unique([userId, symbol])
  @@map("stocks")
}

// 銘柄メモ
model StockMemo {
  id        String   @id @default(cuid())
  stockId   String   @unique @map("stock_id")
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_memos")
}

// 株価情報
model StockPrice {
  id            String    @id @default(cuid())
  stockId       String    @unique @map("stock_id")
  currentPrice  Decimal?  @map("current_price")  // 現在株価
  targetPrice   Decimal?  @map("target_price")   // 目標株価
  stopLossPrice Decimal?  @map("stop_loss_price") // 損切り価格
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  stock         Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_prices")
}

// 保有ポジション（購入ロットごとに1レコード）
model StockPosition {
  id            String    @id @default(cuid())
  stockId       String    @map("stock_id")        // @unique を削除：1銘柄に複数ポジション
  shares        Int                                // 購入株数
  purchasePrice Decimal   @map("purchase_price")  // 取得単価（1株あたり）
  purchaseDate  String?   @map("purchase_date")   // 取得日（YYYY-MM-DD）
  memo          String?                            // メモ
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  stock         Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_positions")
}

// 銘柄イベント（決算、株主総会等）
model StockEvent {
  id          String      @id @default(cuid())
  stockId     String      @map("stock_id")
  eventType   EventType   @map("event_type") // "EARNINGS", "SHAREHOLDER_MEETING"
  eventDate   DateTime?   @map("event_date") // 決算日（YYYY-MM-DD）。株主総会は月/日設定を使用
  eventMonth  Int?        @map("event_month") // 株主総会の月（1-12）
  eventDay    Int?        @map("event_day")   // 株主総会の日（1-31）
  isRecurring Boolean     @default(false) @map("is_recurring") // 毎年繰り返し
  isActive    Boolean     @default(true) @map("is_active")     // 有効/無効
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  stock       Stock       @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, eventType])
  @@map("stock_events")
}

// 配当情報
model StockDividend {
  id              String    @id @default(cuid())
  stockId         String    @unique @map("stock_id")
  dividendPerShare Decimal? @map("dividend_per_share") // 1株配当金
  frequency       Int?      @default(1) // 年間配当回数
  rightsMonth     Int?      @map("rights_month") // 権利確定月
  rightsDay       Int?      @map("rights_day") // 権利確定日
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  stock           Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_dividends")
}

// 株主優待情報
model StockBenefit {
  id             String    @id @default(cuid())
  stockId        String    @unique @map("stock_id")
  description    String?   // 優待内容
  minimumShares  Int?      @map("minimum_shares") // 必要株数
  estimatedValue Decimal?  @map("estimated_value") // 推定価値
  rightsMonth    Int?      @map("rights_month") // 権利確定月
  rightsDay      Int?      @map("rights_day") // 権利確定日
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  stock          Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_benefits")
}

// タグ管理
model StockTag {
  id        String   @id @default(cuid())
  stockId   String   @map("stock_id")
  name      String
  color     String   @default("gray")
  createdAt DateTime @default(now()) @map("created_at")

  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, name])
  @@map("stock_tags")
}

// Next Action Plan（次の一手戦略）
model NextActionPlan {
  id           String      @id @default(cuid())
  stockId      String      @unique @map("stock_id")
  actionType   ActionType  @map("action_type") // "buy", "sell", "hold"
  priority     Priority    // "high", "medium", "low"
  targetPrice  Decimal?    @map("target_price") // 目標価格
  targetShares Int?        @map("target_shares") // 目標株数
  strategyMemo String?     @map("strategy_memo") // 戦略メモ
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  stock        Stock       @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("next_action_plans")
}

// お気に入りグループ
model FavoriteGroup {
  id          String               @id @default(cuid())
  userId      String               @map("user_id")
  name        String
  color       String               @default("blue")
  order       Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockGroups StockFavoriteGroup[]

  @@unique([userId, name])
  @@map("favorite_groups")
}

// お気に入りグループ-銘柄 中間テーブル（多対多）
model StockFavoriteGroup {
  id      String        @id @default(cuid())
  stockId String        @map("stock_id")
  groupId String        @map("group_id")

  stock   Stock         @relation(fields: [stockId], references: [id], onDelete: Cascade)
  group   FavoriteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([stockId, groupId])
  @@map("stock_favorite_groups")
}

// アラートスヌーズ管理
model SnoozedAlert {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  stockSymbol String     @map("stock_symbol") // 銘柄コード
  alertType   AlertType  @map("alert_type") // アラート種別
  snoozeUntil DateTime   @map("snooze_until") // スヌーズ終了時刻
  createdAt   DateTime   @default(now()) @map("created_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("snoozed_alerts")
}

// タブ状態管理
model StockTabState {
  id             String @id @default(cuid())
  stockId        String @map("stock_id")
  tabType        String @map("tab_type") // "active", "management", "investment_strategy"
  currentTab     String @map("current_tab") // タブの現在状態
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  stock          Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, tabType])
  @@map("stock_tab_states")
}

// Enums
enum EventType {
  EARNINGS
  SHAREHOLDER_MEETING
}

enum ActionType {
  BUY
  SELL
  HOLD
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum AlertType {
  FUND_SHORTAGE
  STOP_LOSS_EXCEEDED
  NEXT_ACTION_URGENT
  STOP_LOSS_APPROACHING
  PROFIT_TARGET_APPROACHING
  NEXT_ACTION_WARNING
}

enum FeedbackCategory {
  FEATURE_REQUEST
  IMPROVEMENT
  BUG_REPORT
  OTHER
}

// フィードバック（目安箱）
model Feedback {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  category  FeedbackCategory
  content   String
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}
