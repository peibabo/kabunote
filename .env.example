# =================================
# Kabunote 環境変数テンプレート
# =================================
# このファイルを .env.local にコピーして値を設定してください
# cp .env.example .env.local

# ---------------------------------
# データベース（必須）
# ---------------------------------
# PostgreSQL接続文字列（Prisma用）
# Transaction Pooler(6543): 通常クエリ用
# Session Pooler(5432): DDL用（prisma db push等）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE"

# ---------------------------------
# Supabase（必須）
# ---------------------------------
# SupabaseプロジェクトのURL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabaseアノニマスキー（クライアント側で使用）
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabaseサービスロールキー（サーバー側のみ）
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---------------------------------
# Google Analytics（任意）
# ---------------------------------
# GA4の測定ID（未設定の場合はGA無効）
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ---------------------------------
# Basic認証（任意）
# ---------------------------------
# 設定するとランディングページ以外にBasic認証がかかる
# ステージング環境での保護用
# BASIC_AUTH_USERNAME="username"
# BASIC_AUTH_PASSWORD="password"
